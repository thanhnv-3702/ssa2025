# SAA 2025 — copy to `.env` (dev), `.stag.env` (staging), or `.prod.env`
ENV=dev
BASE_URL=http://10.0.4.129/
DB_NAME=data_stag.db

# Gateway Basic Auth (optional)
API_BASIC_AUTH_USER=
API_BASIC_AUTH_PASSWORD=

# Auth: true = mock Google + mock token (local, no VPN)
SAA_AUTH_MOCK=true

# Google OAuth web client ID (required when SAA_AUTH_MOCK=false)
GOOGLE_SERVER_CLIENT_ID=

# API: true = in-app mock data; false = GET /kudos/hub, /awards, /sunner/search
SAA_API_MOCK=true

# When SAA_API_MOCK=false: true = fall back to mock on empty/error (dev only)
SAA_API_FALLBACK=false
